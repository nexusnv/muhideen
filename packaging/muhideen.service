[Unit]
Description=Muhideen backend HTTP service
# Boot-time TIME UNSYNCED detection needs time-sync.target reached
# (synced-or-failed) and the LAN up before uvicorn binds 0.0.0.0.
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=muhideen
Environment=PYTHONUNBUFFERED=1
# Hand-edited config under /etc/muhideen; machine-written timetable cache
# and media live under /var/lib/muhideen (User=muhideen must write them).
ExecStart=@VENV@/bin/muhideen --host 0.0.0.0 --port 8000 --config /etc/muhideen/muhideen.json --prayer-buffer /var/lib/muhideen/prayer_buffer.json --media-dir /var/lib/muhideen/media
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
